# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# Database
DATABASE_URL=sqlite:///marketplace.db

# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxx
PLATFORM_FEE_PERCENT=10

# App URL (for OAuth & Stripe redirects)
APP_URL=http://localhost:5000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create OAuth 2.0 Client ID → Web application
# Authorized redirect URIs: https://your-domain/login/google/callback
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxx

# Admin email (this Google account becomes admin automatically)
ADMIN_EMAIL=shapyaar@gmail.com

# Country for seller Stripe Express accounts (ISO 2-letter: FR, DE, NL, BE, ...)
STRIPE_CONNECT_COUNTRY=BE

# Security (Render sets RENDER=true automatically)
# FLASK_ENV=production
# SECRET_KEY must be long random — on Render use generateValue

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Admin channel/chat for ALL orders + fees (e.g. -100xxxxxxxxxx)
ADMIN_TELEGRAM_CHAT_ID=

# Cloudinary — images survive Render redeploy
# Get from https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
